# Copy this file to .env before running `docker compose up`.
# Values below match the current docker-compose.yml defaults (SCRUM-29).

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=abra_dev
POSTGRES_PORT=5432

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3000
# Internal URL - "postgres" is the Compose service name, not localhost
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/abra_dev
CORS_ORIGIN=http://localhost:5173
# Dev-only placeholder - do not reuse in any shared/staging/production environment
JWT_SECRET=dev-only-secret-change-me-please-32chars-min
LOG_LEVEL=debug
# Failed-login throttle - defaults shown, override if needed (backend/.env.example)
RATE_LIMIT_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_IP_MAX_ATTEMPTS=50
RATE_LIMIT_WINDOW_SECONDS=900
# Report writes one authenticated caller may make in that same window
RATE_LIMIT_WRITE_MAX_REQUESTS=60
# No proxy in front of the backend in this compose stack - leave disabled
TRUST_PROXY=false

# --- Frontend ---
FRONTEND_PORT=5173
# Must be a host-reachable URL - the browser calls this directly, not the frontend container
VITE_API_URL=http://localhost:3000
