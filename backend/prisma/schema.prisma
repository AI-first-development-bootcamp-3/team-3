generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum WorkLocation {
  OFFICE
  CLIENT
  HOME
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  passwordHash       String
  displayName        String
  role               Role
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attachments        Attachment[]
  timeReports        TimeReport[]

  @@map("users")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects    Project[]
  timeReports TimeReport[]

  @@map("clients")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  tasks       Task[]
  timeReports TimeReport[]

  @@map("projects")
}

model Task {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  project     Project      @relation(fields: [projectId], references: [id])
  timeReports TimeReport[]

  @@map("tasks")
}

/// One row per absence, spanning startDate..endDate (never one row per day —
/// see openspec/changes/absences-schema/design.md). isActive doubles as both
/// the SCRUM-51 soft-delete flag and the "cancelled" business state; there is
/// deliberately no separate status column. A CHECK ("endDate" >= "startDate")
/// constraint on this table is added as raw SQL in the migration — Prisma
/// 7.9.1 has no `@@check` attribute, so it isn't representable here.
model Absence {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      AbsenceType
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  halfDay   Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  documents Attachment[]

  @@index([userId, isActive, startDate, endDate])
  @@map("absences")
}

/// File bytes live outside PostgreSQL, behind the FileStorage interface —
/// this row is metadata plus a reference (storageKey), never the content
/// itself. Not soft-deletable: attachments have no update/delete endpoint
/// in this change. absenceId is nullable by design (see
/// openspec/changes/absences-schema/design.md) so Attachment stays usable
/// for non-absence uploads later without a further schema change.
model Attachment {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  uploadedAt DateTime @default(now())
  absenceId  String?
  absence    Absence? @relation(fields: [absenceId], references: [id])

  @@map("attachments")
}

model TimeReport {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id])
  date         DateTime     @db.Date
  workLocation WorkLocation
  startTime    DateTime     @db.Time
  endTime      DateTime     @db.Time
  description  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("time_reports")
}
