generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum WorkLocation {
  OFFICE
  CLIENT
  HOME
}

enum AbsenceType {
  VACATION
  SICK
  RESERVE_DUTY
  OTHER
}

enum TaskStatus {
  OPEN
  CLOSED
}

enum ReportFormat {
  CLOCK_IN_OUT
  SUM_HOURS
}

enum WorkClockSessionStatus {
  ACTIVE
  AWAITING_CONFIRM
  DISCARDED
}

enum LoginAttemptOutcome {
  CREDENTIAL_REJECTED
  THROTTLED
  LOCKED
  SUCCESS
}

enum TimeReportAuditAction {
  REPLACED
  DELETED
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  passwordHash       String
  displayName        String
  role               Role
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  /// Session-validity boundary (see openspec/changes/user-logout/design.md,
  /// D1): a token whose `iat` predates this moment is refused by
  /// `authenticate`. Only an explicit logout moves this forward - logging in
  /// leaves it untouched, so signing in on one device never ends another
  /// device's session. `@default(now())` is correct for newly created users;
  /// existing rows at migration time are backfilled to a timestamp older
  /// than any live token (see the migration itself), not to `now()`.
  sessionsValidFrom  DateTime      @default(now())
  attachments        Attachment[]
  timeReports        TimeReport[]
  absences           Absence[]
  loginAttempts      LoginAttempt[]
  taskAssignments    TaskAssignment[]
  workClockSessions  WorkClockSession[]
  managedProjects    Project[]         @relation("ProjectManager")
  reportAuditsAsEmployee TimeReportAudit[] @relation("ReportAuditEmployee")
  reportAuditsAsActor    TimeReportAudit[] @relation("ReportAuditActor")

  @@map("users")
}

/**
 * Durable, append-only audit trail of failed and successful credential
 * attempts. The account-lockout tier (see openspec/changes/login-account-lockout)
 * derives its decisions by counting rows here rather than storing a lock
 * flag, so this table is both the audit log and the lock mechanism.
 *
 * emailNormalised is the lock/audit key, not userId - a lock keyed on the
 * user row could never fire for an unregistered email, which would turn
 * lock behavior into an account-existence oracle. userId is recorded only
 * to make the trail joinable for review.
 */
model LoginAttempt {
  id               String               @id @default(uuid())
  emailNormalised  String
  userId           String?
  user             User?                @relation(fields: [userId], references: [id])
  ipAddress        String
  outcome          LoginAttemptOutcome
  createdAt        DateTime             @default(now())

  @@index([emailNormalised, createdAt])
  @@map("login_attempts")
}

model Client {
  id             String    @id @default(uuid())
  name           String
  contactDetails String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects    Project[]
  timeReports TimeReport[]

  @@map("clients")
}

model Project {
  id           String       @id @default(uuid())
  name         String
  isActive     Boolean      @default(true)
  /// Default is SUM_HOURS, not CLOCK_IN_OUT as admin-report-format first set
  /// it: that choice predated `TimeReport.hours`, and once every row became
  /// hours-based, leaving it would have flipped every never-configured
  /// project to per-row clock pairs. See
  /// openspec/changes/report-format-aware-entry/design.md, D8.
  reportFormat ReportFormat @default(SUM_HOURS)
  description  String       @default("")
  /// Inclusive calendar window. Null on older rows means unbounded (no gate).
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  managerId    String?
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id])
  tasks        Task[]
  timeReports  TimeReport[]

  @@map("projects")
}

model Task {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  status    TaskStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  projectId String
  project     Project          @relation(fields: [projectId], references: [id])
  timeReports TimeReport[]
  assignments TaskAssignment[]

  @@map("tasks")
}

/// Current-state assignment only — no soft-delete flag, no history row.
/// Presence of the row means assigned; removal means not assigned. See
/// openspec/changes/admin-data-model/design.md for why this differs from
/// every other model's isActive soft-delete convention.
model TaskAssignment {
  userId    String
  taskId    String
  user      User     @relation(fields: [userId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, taskId])
  @@map("task_assignments")
}

/// One row per absence, spanning startDate..endDate (never one row per day —
/// see openspec/changes/absences-schema/design.md). isActive doubles as both
/// the SCRUM-51 soft-delete flag and the "cancelled" business state; there is
/// deliberately no separate status column. A CHECK ("endDate" >= "startDate")
/// constraint on this table is added as raw SQL in the migration — Prisma
/// 7.9.1 has no `@@check` attribute, so it isn't representable here.
model Absence {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      AbsenceType
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  halfDay   Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  documents Attachment[]

  @@index([userId, isActive, startDate, endDate])
  @@map("absences")
}

/// File bytes live outside PostgreSQL, behind the FileStorage interface —
/// this row is metadata plus a reference (storageKey), never the content
/// itself. Not soft-deletable: attachments have no update/delete endpoint
/// in this change. absenceId is nullable by design (see
/// openspec/changes/absences-schema/design.md) so Attachment stays usable
/// for non-absence uploads later without a further schema change.
model Attachment {
  id         String   @id @default(uuid())
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  uploadedAt DateTime @default(now())
  absenceId  String?
  absence    Absence? @relation(fields: [absenceId], references: [id])

  @@map("attachments")
}

model TimeReport {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id])
  date         DateTime     @db.Date
  workLocation WorkLocation
  /// The *day* attendance window, copied onto every row of that day —
  /// not this row's own interval. manual-report-inline-hours redefined
  /// them this way and the entry form reads the window back off the first
  /// row of a day, so this meaning must not drift.
  startTime    DateTime     @db.Time
  endTime      DateTime     @db.Time
  /// This row's own clock pair, set only when its project's reportFormat is
  /// CLOCK_IN_OUT. NULL on every SUM_HOURS row — including every row saved
  /// before report-format-aware-entry, all of which were hours-only.
  rowStartTime DateTime?    @db.Time
  rowEndTime   DateTime?    @db.Time
  /// Typed by the employee on a SUM_HOURS row; derived from
  /// rowStartTime..rowEndTime on a CLOCK_IN_OUT row.
  hours        Decimal      @db.Decimal(4, 1)
  description  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("time_reports")
}

/// Admin month close (SCRUM-146). One row per calendar month when locked.
model MonthLock {
  year       Int
  month      Int
  lockedAt   DateTime @default(now())
  lockedById String

  @@id([year, month])
  @@map("month_locks")
}

/// Server-backed employee work clock (SCRUM-305). One open session per user.
model WorkClockSession {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  startedAt   DateTime
  stoppedAt   DateTime?
  status      WorkClockSessionStatus
  autoStopped Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, status])
  @@map("work_clock_sessions")
}

/// Append-only trail of an administrator replacing or deleting another
/// employee's day. Employee self-saves on `/reports` do not write here.
model TimeReportAudit {
  id           String                 @id @default(uuid())
  employeeId   String
  employee     User                   @relation("ReportAuditEmployee", fields: [employeeId], references: [id])
  actorId      String
  actor        User                   @relation("ReportAuditActor", fields: [actorId], references: [id])
  date         DateTime               @db.Date
  action       TimeReportAuditAction
  previousJson Json
  nextJson     Json?
  reason       String?
  createdAt    DateTime               @default(now())

  @@index([employeeId, date])
  @@map("time_report_audits")
}
