# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials. See src/config/env.ts for validation rules.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string (Prisma format)
# Local/Docker default matches the postgres service in docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/abra_dev"

# Comma-separated list of origins allowed to call this API from a browser.
# Include the frontend's dev server and its Docker service name.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# HS256 signing key for JWTs — minimum 32 characters.
# Generate a real one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-real-32-plus-character-secret"

# Default session lifetime, in seconds. Optional — defaults to 28800 (8 hours).
JWT_EXPIRES_IN_SECONDS=28800

# Session lifetime, in seconds, when the caller opts into "remember me" at
# login. Optional — defaults to 2592000 (30 days). Must be >= JWT_EXPIRES_IN_SECONDS.
JWT_REMEMBER_ME_EXPIRES_IN_SECONDS=2592000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Local-filesystem root for uploaded attachments. Optional — defaults to
# ./storage/uploads. A mounted volume in Docker/production; free-tier
# container filesystems are ephemeral (see backend/README.md -> File storage).
STORAGE_DIR=./storage/uploads

# Failed-attempt throttle on /login and /me/password, within a rolling
# window. All three optional — default to 5 attempts per email, 50 per
# client address, over a 900-second (15 minute) window.
RATE_LIMIT_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_IP_MAX_ATTEMPTS=50
RATE_LIMIT_WINDOW_SECONDS=900

# How many reverse-proxy hops in front of this service to trust when
# resolving a client's address (Express's `trust proxy` setting). Optional —
# defaults to "false" (no proxy trusted; safe for local/direct-exposed
# deployments). Set to "true" to trust the first hop, an integer for a hop
# count, or a comma-separated list of trusted addresses/CIDR ranges when
# behind a known proxy. Getting this wrong either makes per-address
# rate-limiting spoofable (trusting a proxy that isn't there) or collapses
# every real client into one bucket (leaving it disabled behind a real one).
TRUST_PROXY=false
